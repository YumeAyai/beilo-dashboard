<!doctype html>
<html lang="zh-CN" xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><title>{{.Subject}}</title><style>
body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}table,td{mso-table-lspace:0pt;mso-table-rspace:0pt}table{border-collapse:collapse}img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic}body{margin:0!important;padding:0!important;width:100%!important}a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important}.preheader{display:none!important;visibility:hidden;opacity:0;color:transparent;height:0;width:0;max-height:0;overflow:hidden;mso-hide:all}.fallback-url{word-break:break-all;overflow-wrap:anywhere}.details{white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere}
@media screen and (max-width:640px){.outer-pad{padding:20px 12px!important}.mail-container{width:100%!important;max-width:100%!important}.content-pad{padding:27px 22px!important}.masthead-pad{padding:22px!important}.mail-title{font-size:24px!important;line-height:1.5!important}.brand-caption{font-size:10px!important}.environment{font-size:9px!important;letter-spacing:0!important}.data-label{width:34%!important;font-size:11px!important}.data-value{font-size:12px!important}.metric-value{font-size:24px!important}.metric-label{font-size:10px!important}.footer-pad{padding:22px 16px!important}.action-table{width:100%!important}.action-link{display:block!important}.footer-verse{font-size:10px!important;letter-spacing:1px!important}}
@media (prefers-color-scheme:dark){body,.email-canvas{background-color:#101722!important}.mail-surface,.content-pad{background-color:#1b2431!important}.mail-title,.body-text,.data-value,.metric-value,.steps-text{color:#e6edf8!important}.muted,.data-label,.section-label,.metric-label{color:#9cabc2!important}.mail-card,.data-row td,.section-border,.detail-surface,.metrics-surface{border-color:#354153!important}.detail-surface,.metrics-surface{background-color:#131d2b!important}.detail-text{color:#bdcfe9!important}.footer-text{color:#8c9db6!important}.footer-verse{color:#9fb8dc!important}.fallback-url{color:#97b9e7!important}}
</style></head><body style="margin:0;padding:0;background-color:#f3f5f8;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',Arial,sans-serif;color:#1d2738;">
<div class="preheader" style="display:none;visibility:hidden;opacity:0;color:transparent;font-size:1px;line-height:1px;height:0;max-height:0;max-width:0;overflow:hidden;mso-hide:all;">{{.Preheader}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-canvas" style="background-color:#f3f5f8;"><tr><td class="outer-pad" align="center" style="padding:38px 20px 28px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="mail-container" style="width:600px;max-width:600px;border-collapse:separate;border-spacing:0;">
<tr><td><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="mail-card" style="width:100%;border-collapse:separate;border-spacing:0;border:1px solid #e2e7ee;border-radius:12px;overflow:hidden;">
<tr><td class="masthead-pad" bgcolor="#111c30" style="padding:26px 32px;background-color:#111c30;border-radius:12px 12px 0 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="49" valign="middle"><img src="cid:beilo-logo" width="39" height="39" alt="" style="display:block;width:39px;height:39px;"></td><td valign="middle"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td valign="bottom" style="font-size:28px;line-height:32px;font-weight:600;letter-spacing:-1.2px;color:#f3f7ff;white-space:nowrap;">beilo<span aria-hidden="true" style="display:inline-block;width:4px;height:4px;margin-left:2px;border-radius:50%;vertical-align:baseline;background-color:#BCD6FF;"></span></td><td valign="middle" style="padding-left:10px;"><!-- beilo-chinese --></td></tr></table><div class="brand-caption" style="font-family:'Courier New',monospace;font-size:9px;line-height:18px;letter-spacing:1.6px;color:#7692bc;white-space:nowrap;">NOTIFICATION CENTER</div></td><td align="right" valign="middle"><span class="environment" style="font-size:10px;line-height:1.7;color:#b2c7e6;letter-spacing:.5px;">✦ &nbsp;{{.Environment}}</span></td></tr></table></td></tr>
<tr><td class="mail-surface content-pad" bgcolor="#ffffff" style="background-color:#ffffff;padding:32px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding-bottom:15px;"><span style="display:inline-block;background-color:{{.Variant.Tint}};color:{{.Variant.Color}};border:1px solid {{.Variant.Border}};border-radius:5px;padding:5px 8px;font-size:10px;line-height:1.3;font-weight:600;letter-spacing:.3px;">{{.Variant.Badge}}</span><span class="muted" style="font-family:'Courier New',monospace;font-size:9px;color:#94a0b2;margin-left:10px;letter-spacing:.9px;">{{.Variant.Category}}</span></td></tr><tr><td><h1 class="mail-title" style="font-size:27px;line-height:1.5;font-weight:600;letter-spacing:-.5px;color:#1d2738;margin:0 0 13px;">{{.Title}}</h1><p class="body-text" style="font-size:13px;line-height:1.95;color:#607088;margin:0;">{{.Summary}}</p></td></tr></table>
{{if .Status}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:23px;"><tr><td bgcolor="{{.Variant.Tint}}" style="background-color:{{.Variant.Tint}};border-left:3px solid {{.Variant.Color}};padding:13px 15px;"><p style="color:{{.Variant.Color}};font-size:12px;line-height:1.8;font-weight:600;margin:0;">{{.Status}}</p>{{if .StatusDetail}}<p style="font-size:11px;line-height:1.85;color:#65728a;margin:4px 0 0;">{{.StatusDetail}}</p>{{end}}</td></tr></table>{{end}}
{{if .Metrics}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="metrics-surface" bgcolor="#f6f8fb" style="margin-top:23px;background-color:#f6f8fb;border:1px solid #e6ebf2;"><tr>{{range .Metrics}}<td align="center" width="{{$.MetricWidth}}" style="padding:18px 7px;vertical-align:top;"><div class="metric-value" style="font-size:28px;line-height:1.4;color:#263954;font-weight:600;letter-spacing:-.8px;">{{.Value}}</div><div class="metric-label" style="font-size:11px;line-height:1.9;color:#7d8ba0;margin-top:6px;">{{.Label}}</div></td>{{end}}</tr></table>{{end}}
{{if .Fields}}<p class="section-label" style="margin:27px 0 10px;font-size:10px;letter-spacing:1.2px;font-weight:600;color:#8a99af;">事件信息 / EVENT DETAILS</p><table width="100%" cellpadding="0" cellspacing="0" border="0" aria-label="事件信息" style="width:100%;table-layout:fixed;">{{range .Fields}}<tr class="data-row"><td class="data-label" width="31%" valign="top" style="width:31%;padding:10px 0;border-bottom:1px solid #edf0f5;font-size:11px;line-height:1.8;color:#8795aa;">{{.Label}}</td><td class="data-value" valign="top" style="padding:10px 0 10px 10px;border-bottom:1px solid #edf0f5;font-size:12px;line-height:1.8;color:#35435b;word-break:break-word;overflow-wrap:anywhere;{{if .Monospace}}font-family:'Courier New',monospace;{{end}}">{{.Value}}</td></tr>{{end}}</table>{{end}}
{{if .Details}}<p class="section-label" style="margin:25px 0 10px;font-size:10px;letter-spacing:1px;font-weight:600;color:#8a99af;">{{.DetailsTitle}}</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="detail-surface" bgcolor="#f6f8fb" style="background-color:#f6f8fb;border:1px solid #e4eaf3;"><tr><td style="padding:14px 16px;"><div class="detail-text details" style="font-family:'Courier New',monospace;font-size:11px;line-height:1.9;color:#59718f;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere;">{{.Details}}</div></td></tr></table>{{end}}
{{if .NextSteps}}<p class="section-label" style="margin:25px 0 11px;font-size:10px;letter-spacing:1px;font-weight:600;color:#8a99af;">建议下一步 / NEXT STEPS</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">{{range .NextSteps}}<tr><td width="17" valign="top" style="font-size:13px;line-height:1.9;color:#5588d3;padding:3px 0;">•</td><td class="steps-text" style="font-size:12px;line-height:1.9;color:#65758c;padding:3px 0;">{{.}}</td></tr>{{end}}</table>{{end}}
{{if .ActionURL}}<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="action-table" style="margin-top:27px;"><tr><td align="center" bgcolor="#5588d3" style="background-color:#5588d3;border-radius:7px;mso-padding-alt:13px 25px;"><a class="action-link" href="{{.ActionURL}}" style="display:inline-block;background-color:#5588d3;border:1px solid #5588d3;border-radius:7px;padding:12px 24px;font-size:12px;line-height:1.5;color:#ffffff;text-decoration:none;font-weight:600;">{{.ActionLabel}} &nbsp; →</a></td></tr></table><p class="muted" style="font-size:10px;line-height:1.8;color:#99a5b7;margin:14px 0 0;">按钮无法打开？将以下链接复制到浏览器：</p><p style="font-size:10px;line-height:1.9;margin:5px 0 0;"><a class="fallback-url" href="{{.ActionURL}}" style="color:#5588d3;text-decoration:none;word-break:break-all;overflow-wrap:anywhere;">{{.ActionURL}}</a></p>{{end}}
{{if .FooterNote}}<p class="muted section-border" style="font-size:10px;line-height:1.9;color:#8a99af;margin:25px 0 0;padding-top:16px;border-top:1px solid #edf0f5;">{{.FooterNote}}</p>{{end}}
</td></tr>
<tr><td class="mail-surface footer-pad" bgcolor="#f9fbfe" style="padding:20px 32px;background-color:#f9fbfe;border-radius:0 0 12px 12px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="footer-text" style="font-size:10px;line-height:1.9;color:#95a2b5;">{{.Reason}}<br>此邮件由 beilo. 自动发送，请通过控制台处理通知。{{if .ID}}<br><span style="font-family:'Courier New',monospace;font-size:9px;">ID: {{.ID}}</span>{{end}}{{if .OccurredAt}}<br><span style="font-size:9px;">{{.OccurredAt}}</span>{{end}}</td></tr>{{if .PreferencesURL}}<tr><td style="padding-top:10px;"><a href="{{.PreferencesURL}}" style="font-size:10px;color:#5588d3;text-decoration:none;">管理通知设置 →</a></td></tr>{{end}}</table></td></tr>
</table></td></tr>
<tr><td align="center" style="padding:22px 12px 5px;"><p class="footer-verse" style="font-family:'Songti SC',SimSun,'Noto Serif SC',serif;font-size:11px;line-height:1.9;letter-spacing:1.7px;color:#7489a9;margin:0;">观壁垒于北落兮，伐河鼓之磅硠</p><p class="footer-text" style="font-size:9px;line-height:1.8;letter-spacing:.4px;color:#a0acbd;margin:7px 0 0;">beilo. · CLOUD-NATIVE SECURITY &amp; OBSERVABILITY</p></td></tr>
</table></td></tr></table></body></html>
